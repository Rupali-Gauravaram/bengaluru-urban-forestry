# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor / local tooling
desktop.ini
.DS_Store
.vscode/
.claude/

# Large source PDFs — too big for git; their source is documented in the README.
*.pdf

# Real input datasets — author's own work, NOT for public redistribution.
# A small sampled subset lives in sample_data/ so the pipeline stays runnable.
data/

# Exclude data CSVs by default...
*.csv
# ...but DO commit the small public sample, so the repo runs out of the box.
!sample_data/
!sample_data/*.csv

# Generated pipeline outputs (reproducible by running main.py)...
output/
# ...except the ward master stats, which the API reads at startup.
!output/Bengaluru_Ward_Master_Stats.csv
